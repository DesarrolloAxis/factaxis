# --- Base de datos (Railway PostgreSQL) ---
DATABASE_URL=postgres://user:password@localhost:5432/factaxis
PGSSL=false

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Vault / cifrado at-rest de secretos DTE ---
# Clave maestra usada por el vault local (AES-256-GCM) para cifrar certificados
# digitales (.pfx) y llaves RSA de CAF antes de guardarlas en DB/disco.
# En producción, reemplazar VAULT_PROVIDER por "aws-secrets-manager" o "hashicorp-vault"
# y esta variable deja de usarse (ver services/dte/vault.service.js).
VAULT_PROVIDER=local
VAULT_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_KEY_XXXXXXXXXXXX

# --- SII ---
# mock: usa el simulador local (services/dte/sii-client/mock.client.js)
# soap: usa el cliente SOAP real contra maullin.sii.cl / palena.sii.cl
SII_CLIENT_MODE=mock

# --- Job de estado ---
DTE_POLLER_CRON=*/5 * * * *
